# 这是配置模板文件，用于说明需要哪些环境变量，可以直接提交到代码仓库。
# 请复制本文件为 .env，然后填入真实的值（.env 已被 .gitignore 忽略，不会提交）。
#
# ⚠️ 千万不要把真实密钥写在本文件里，本文件会被推送到 GitHub。

# DeepSeek 开放平台密钥，用于 AI 解析家教信息
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 高德开放平台 Web 服务密钥，用于地址解析与路径规划
# 获取地址：https://console.amap.com/dev/key/app
AMAP_KEY=

# 可选：允许跨域的前端来源，多个用英文逗号分隔
# 不配置时默认放开全部来源，方便本地开发；上线建议改成自己的域名
# 例如：http://你的IP:8080,http://localhost:3000
ALLOW_ORIGINS=*

# 可选：单个 IP 在 RATE_WINDOW 秒内的最大请求数，设为 0 表示不限流
RATE_LIMIT=60
RATE_WINDOW=60

# 可选：DeepSeek 接口地址与模型名，一般无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
